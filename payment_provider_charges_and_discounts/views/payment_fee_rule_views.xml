<odoo>
    <record id="payment_provider_view_form_inherit_charges" model="ir.ui.view">
        <field name="name">payment.provider.view.form.inherit.charges</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Charge Rules" name="charge_rules">
                    <field name="charge_rule_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="rule_type" string="Fee Type" />
                            <field
                                name="value"
                                invisible="rule_type == 'fixed'"
                                required="rule_type != 'fixed'"
                                widget="percentage"
                            />
                            <field
                                name="value_currency"
                                invisible="rule_type != 'fixed'"
                                required="rule_type == 'fixed'"
                            />
                            <field name="account_id" />
                            <field name="currency_id" column_invisible="1" />
                        </tree>
                    </field>
                </page>
                <page string="Discount Rules" name="discount_rules">
                    <field name="discount_rule_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="rule_type" string="Discount Type" />
                            <field
                                name="value"
                                invisible="rule_type == 'fixed'"
                                required="rule_type != 'fixed'"
                                widget="percentage"
                            />
                            <field
                                name="value_currency"
                                invisible="rule_type != 'fixed'"
                                required="rule_type == 'fixed'"
                            />
                            <field name="account_id" />
                            <field name="currency_id" column_invisible="1" />
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
